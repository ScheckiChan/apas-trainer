# Copy to .env and fill in. Read by the API (npm run dev / start load ../../.env
# automatically; docker compose reads it via env_file).

# --- Core -------------------------------------------------------------------
# HTTP port of the API process (inside the container always 3001).
PORT=3001
# Directory for the JSON data files (one file per collection). Relative paths are
# resolved from the API's working directory (apps/api in dev). Compose uses /data.
DATA_DIR=./data
# Secret for signing JWTs (both Ausbildungsleiter and Teilnehmer tokens).
# REQUIRED in production. Generate with:  openssl rand -base64 48
JWT_SECRET=
# Token lifetimes (jsonwebtoken / ms syntax).
LEITER_TOKEN_TTL=7d
TEILNEHMER_TOKEN_TTL=90d
# Magic-link validity in minutes.
MAGIC_LINK_TTL_MINUTES=30

# --- URLs -------------------------------------------------------------------
# Public URL of the web app — used to build magic links (and must match where
# the PWA is served). Dev: Vite on 5173. Compose: http://<host>:8080 or your domain.
PUBLIC_URL=http://localhost:5173
# Comma separated allowed CORS origins. Leave empty when web and API share an
# origin (Vite proxy in dev, nginx proxy in compose).
CORS_ORIGIN=
# Express "trust proxy" setting (needed for correct client IPs in rate limiting
# behind nginx / a reverse proxy). Defaults to 1 in production.
TRUST_PROXY=

# --- Push notifications (web-push / VAPID) ----------------------------------
# Generate once with:  npm run generate-vapid
# Leave empty to disable push (the app works without it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services — mailto: or https: URL.
VAPID_SUBJECT=mailto:ausbildung@example.at
# Send a reminder this many hours before each Termin...
REMINDER_HOURS_BEFORE=24
# ...checking for due reminders every N minutes.
REMINDER_INTERVAL_MINUTES=5
# Timezone used when formatting dates in reminder texts.
TZ=Europe/Vienna

# --- docker compose host ports ----------------------------------------------
API_PORT=3001
WEB_PORT=8080

# --- seed-admin (optional, for non-interactive use) -------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
